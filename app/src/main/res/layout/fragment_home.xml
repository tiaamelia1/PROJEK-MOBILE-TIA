<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- HEADER EDUSHARE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="#FFFFFF"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/txtLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EduShare"
            android:textColor="#10264F"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtSubtitle"
            app:layout_constraintVertical_chainStyle="packed"/>

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Berbagi Ilmu, Tumbuh Bersama"
            android:textColor="#7890AD"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/txtLogo"
            app:layout_constraintTop_toBottomOf="@id/txtLogo"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/btnNotification"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="♧"
            android:textColor="#10264F"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- KONTEN YANG BISA DI-SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="110dp"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- SEARCH -->
            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:background="@drawable/bg_edittext"
                android:hint="Cari materi, mata kuliah, atau topik..."
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#10264F"
                android:textColorHint="#7890AD"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- BANNER INFORMASI -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBanner"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#C8E0FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/edtSearch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Satu catatan\nbisa jadi penyelamat\nuntuk banyak orang."
                        android:textColor="#0751B5"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Yuk, berbagi dan temukan materi\npembelajaran terbaik di EduShare!"
                        android:textColor="#4777B5"
                        android:textSize="12sp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- INDIKATOR BANNER -->
            <LinearLayout
                android:id="@+id/bannerIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/cardBanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            </LinearLayout>

            <!-- JUDUL KATEGORI -->
            <TextView
                android:id="@+id/txtKategori"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Kategori Materi"
                android:textColor="#10264F"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/bannerIndicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- GRID KATEGORI -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:columnCount="1"
                app:useDefaultMargins="false"
                app:layout_constraintTop_toBottomOf="@id/txtKategori"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- CATATAN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D9D9F5"
                    app:strokeWidth="1dp"
                    app:layout_column="0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="60dp"
                            android:background="#DDF2FF"
                            android:gravity="center"
                            android:text="▤"
                            android:textColor="#0751B5"
                            android:textSize="38sp"/>

                        <TextView
                            android:id="@+id/btnCatatan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Catatan"
                            android:textColor="#10264F"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- RANGKUMAN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D9D9F5"
                    app:strokeWidth="1dp"
                    app:layout_column="0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="60dp"
                            android:background="#DDF2FF"
                            android:gravity="center"
                            android:text="♟"
                            android:textColor="#0751B5"
                            android:textSize="38sp"/>

                        <TextView
                            android:id="@+id/btnRangkuman"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Rangkuman"
                            android:textColor="#10264F"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- LATIHAN SOAL -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D9D9F5"
                    app:strokeWidth="1dp"
                    app:layout_column="0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="60dp"
                            android:background="#DDF2FF"
                            android:gravity="center"
                            android:text="▣"
                            android:textColor="#0751B5"
                            android:textSize="38sp"/>

                        <TextView
                            android:id="@+id/btnLatihanSoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Latihan Soal"
                            android:textColor="#10264F"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- MATERI KULIAH -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D9D9F5"
                    app:strokeWidth="1dp"
                    app:layout_column="0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="60dp"
                            android:background="#DDF2FF"
                            android:gravity="center"
                            android:text="▰"
                            android:textColor="#0751B5"
                            android:textSize="38sp"/>

                        <TextView
                            android:id="@+id/btnMateriKuliah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Materi Kuliah"
                            android:textColor="#10264F"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BUKU -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D9D9F5"
                    app:strokeWidth="1dp"
                    app:layout_column="0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="60dp"
                            android:background="#DDF2FF"
                            android:gravity="center"
                            android:text="▱"
                            android:textColor="#0751B5"
                            android:textSize="38sp"/>

                        <TextView
                            android:id="@+id/btnBuku"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Buku"
                            android:textColor="#10264F"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- FAVORIT -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D9D9F5"
                    app:strokeWidth="1dp"
                    app:layout_column="0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="60dp"
                            android:background="#DDF2FF"
                            android:gravity="center"
                            android:text="☆"
                            android:textColor="#0751B5"
                            android:textSize="38sp"/>

                        <TextView
                            android:id="@+id/btnFavorit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Favorit"
                            android:textColor="#10264F"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.gridlayout.widget.GridLayout>

            <!-- CEK DETAIL -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_Detail"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:text="Cek Detail"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#1677F2"
                app:cornerRadius="20dp"
                app:layout_constraintTop_toBottomOf="@id/gridMenu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- LOGOUT -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_LogOut"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="25dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#F04444"
                app:cornerRadius="20dp"
                app:layout_constraintTop_toBottomOf="@id/btn_Detail"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
